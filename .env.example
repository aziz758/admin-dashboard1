# نسخ هذا الملف إلى `.env` أو `.env.local` وعدّل القيم.
# Copy to `.env` or `.env.local` and adjust values.
#
# Vite يعرض للمتصفح فقط المتغيرات التي تبدأ بـ VITE_
# Only VITE_* variables are exposed to the browser.

# عنوان خادم الـ API (بدون شرطة في النهاية اختياري).
# إن لم تُضف `/api` في النهاية، يُضاف تلقائياً في `src/services/api.ts`.
#
# API origin. If the path does not end with `/api`, it is appended in code.
#
# أمثلة / Examples:
#   VITE_API_URL=http://localhost:8000
#   VITE_API_URL=http://localhost:8000/api
#   VITE_API_URL=https://api.example.com

VITE_API_URL=http://localhost:8000/api